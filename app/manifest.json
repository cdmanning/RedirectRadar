{
  "manifest_version": 3,
  "name": "Redirect Radar",
  "short_name": "Redirect Radar",
  "description": "Monitor and log those sneaky URL redirects",
  "version": "1.0.1",
  "author": "Starswept Development",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon_active_48.png",
      "48": "icons/icon_active_48.png"
    },
    "default_popup": "/popup/popup.html",
    "default_title": "Redirect Radar"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "offline_enabled": true
}